# Copier en .env (ignoré par git) à côté de compose.yaml et adapter.
# Image construite localement (tant que l'image GHCR n'est pas publiée ou pas publique) :
#CLOUDBOX_IMAGE=cloudbox:web
#CLOUDBOX_PORT=8080
#CLOUDBOX_TOKEN=
#CLOUDBOX_SUDO=false
#CLOUDBOX_SHELL=pwsh
#CLOUDBOX_MODE=web
#TZ=Europe/Paris
# Assistant IA : « off » l'interdit ; clés facultatives (sinon saisies dans le portail)
#CLOUDBOX_ASSISTANT=
#CLOUDBOX_OPENROUTER_API_KEY=
#CLOUDBOX_ANTHROPIC_API_KEY=
#CLOUDBOX_OPENAI_API_KEY=
