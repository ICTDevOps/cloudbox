# Copier en .env (ignoré par git) à côté de compose.yaml et adapter.
# Image construite localement (tant que l'image GHCR n'est pas publiée ou pas publique) :
#CLOUDBOX_IMAGE=cloudbox:web
#CLOUDBOX_PORT=8080
#CLOUDBOX_TOKEN=
#CLOUDBOX_SUDO=false
#CLOUDBOX_SHELL=pwsh
#CLOUDBOX_MODE=web
#TZ=Europe/Paris
