{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Europe/Paris",
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions épinglées par un commentaire « # renovate: » au-dessus d'une ligne ARG <OUTIL>_VERSION (Dockerfile) ou <OUTIL>_VERSION= (scripts de test)",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/^tests/.+\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s+(?:ARG )?[A-Z0-9_]+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "customDatasources": {
    "openvsx": {
      "description": "Extensions VS Code publiées sur Open VSX (versions stables uniquement)",
      "defaultRegistryUrlTemplate": "https://open-vsx.org/api/-/query?extensionId={{packageName}}&includeAllVersions=true&size=200",
      "transformTemplates": [
        "{\"releases\": $each(extensions[$not(preRelease = true)]{version: $min($map(timestamp, function($x) { $toMillis($x) }))}, function($t, $v) { {\"version\": $v, \"releaseTimestamp\": $fromMillis($t)} })}"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Patch et minor : fusion automatique si le build et le test de fumée sont verts",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Versions majeures : revue manuelle",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major"
      ]
    },
    {
      "description": "Node.js : rester sur les versions LTS",
      "matchDatasources": [
        "node-version"
      ],
      "matchPackageNames": [
        "node"
      ],
      "versioning": "node"
    },
    {
      "description": "@types/node suit la version majeure de Node.js de l'image (NODE_VERSION) : à changer avec elle",
      "matchPackageNames": [
        "@types/node"
      ],
      "allowedVersions": "24.x"
    },
    {
      "description": "dockview fournit le CSS et réexporte dockview-core : toujours à la même version, dans une seule PR",
      "matchPackageNames": [
        "dockview",
        "dockview-core"
      ],
      "groupName": "dockview"
    },
    {
      "description": "L'image :web part de l'image :cli construite dans le même workflow",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/ictdevops/cloudbox"
      ],
      "enabled": false
    }
  ]
}
