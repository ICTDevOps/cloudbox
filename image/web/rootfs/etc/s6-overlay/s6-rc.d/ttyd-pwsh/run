#!/command/with-contenv bash
# Terminal web PowerShell : ttyd sur un socket UNIX, derrière Caddy (/term/pwsh/).
# cloudbox-term lance ou rattache la session tmux (fermer l'onglet ne tue pas le shell) ;
# --url-arg transmet ?arg=<workspace>~<n> pour les panneaux des workspaces (validé par cloudbox-term).
unset CLOUDBOX_TOKEN
# Clés API de l'assistant : réservées à cloudbox-api, jamais visibles dans un shell
for v in $(compgen -e | grep -E '^CLOUDBOX_[A-Z0-9_]+_API_KEY$'); do unset "$v"; done
socket=/run/cloudbox/ttyd-pwsh.sock
rm -f "$socket"
cd /home/dev
exec ttyd --interface "$socket" --base-path /term/pwsh --writable --check-origin --url-arg \
    --debug 3 \
    --index /usr/share/cloudbox/ttyd/index.html \
    --client-option titleFixed=PowerShell \
    --client-option fontSize=14 \
    --client-option disableLeaveAlert=true \
    --client-option disableResizeOverlay=true \
    /usr/local/bin/cloudbox-term pwsh
