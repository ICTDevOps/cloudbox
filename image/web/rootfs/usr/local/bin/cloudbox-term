#!/usr/bin/env bash
# Lance (ou rattache) la session tmux d'un terminal web. Appelé par ttyd :
#   cloudbox-term <pwsh|bash>                   session « pwsh » / « bash » (entrées /term/pwsh/, /term/bash/)
#   cloudbox-term <pwsh|bash> <workspace>~<n>   panneau n d'un workspace (?arg=<workspace>~<n>)
#
# L'argument vient de l'URL (ttyd --url-arg) : il est validé strictement avant tout usage.
set -uo pipefail

home=/home/dev
refuse() {
    printf '\r\n\e[31mCloudbox : %s\e[0m\r\n' "$1"
    sleep 5
    exit 1
}

shell=${1:-}
case $shell in
    pwsh) cmd='pwsh -NoLogo -Login' ;;
    bash) cmd='bash -l' ;;
    *) refuse "shell inconnu" ;;
esac
shift

# Sans argument : terminal simple, session partagée « pwsh » ou « bash »
if (( $# == 0 )); then
    cd "$home" && exec tmux new-session -A -s "$shell" "$cmd"
fi

# Un seul argument accepté (?arg=a&arg=b est possible côté URL)
(( $# == 1 )) || refuse "un seul argument attendu"
[[ $1 =~ ^([a-z0-9][a-z0-9-]{0,31})~([0-9]{1,4})$ ]] || refuse "argument invalide"
workspace=${BASH_REMATCH[1]}
panel=$((10#${BASH_REMATCH[2]}))

state=$home/.cloudbox/workspaces/$workspace.json
[[ -f $state ]] || refuse "workspace « $workspace » introuvable"

# Dossier de travail : celui du workspace s'il existe et reste sous /home/dev, sinon le home
folder=$(jq -r '.folder // empty' "$state" 2>/dev/null) || folder=
folder=$(realpath -e -- "${folder:-$home}" 2>/dev/null) || folder=$home
[[ $folder == "$home" || $folder == "$home"/* ]] || folder=$home

# Connexions du workspace : isolées (défaut) ou partagées. En mode isolé, az, azd, gh et le contexte
# Kubernetes ont leurs dossiers dans ~/.cloudbox/identities/<workspace>/ (mêmes variables que
# identityEnv dans cloudbox-api). Le mode est fixé à l'ouverture de la session tmux : un terminal
# déjà ouvert garde le sien (CLOUDBOX_IDENTITIES, lu par l'API et par le prompt).
identities=$(jq -r '.identities // "isolated"' "$state" 2>/dev/null) || identities=isolated
[[ $identities == shared ]] || identities=isolated
envs=(-e "CLOUDBOX_WORKSPACE=$workspace" -e "CLOUDBOX_IDENTITIES=$identities")
if [[ $identities == isolated ]]; then
    ids=$home/.cloudbox/identities/$workspace
    (umask 077 && mkdir -p "$ids/azure" "$ids/azd" "$ids/gh" "$ids/kube")
    # kubeconfig du workspace : contexte courant et clusters ajoutés ici ; ~/.kube/config reste lu
    [[ -s $ids/kube/config ]] || (umask 077 && printf 'apiVersion: v1\nkind: Config\n' > "$ids/kube/config")
    # Extensions az (outils, pas identités) : communes à tous les workspaces
    envs+=(-e "AZURE_CONFIG_DIR=$ids/azure" -e "AZURE_EXTENSION_DIR=$home/.azure/cliextensions"
           -e "AZD_CONFIG_DIR=$ids/azd" -e "GH_CONFIG_DIR=$ids/gh"
           -e "KUBECONFIG=$ids/kube/config:$home/.kube/config")
fi

# Session <workspace>_<shell>_<n> : « _ » est exclu des identifiants de workspace
session="${workspace}_${shell}_${panel}"
cd "$folder" || cd "$home"
exec tmux new-session -A -s "$session" -c "$folder" "${envs[@]}" "$cmd"
